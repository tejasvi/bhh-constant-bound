/-- the table entry `j` (row `j / 64`, column `j % 64`) -/
def csLit (j : Nat) : Iv × Iv := (csRows.getD (j / 64) []).getD (j % 64) csTrivial

/-- `cosSinTab` with the literal table -/
def cosSinTabLit (t : Int) : Iv × Iv :=
  if t.natAbs ≤ 7 * ONE.toNat then
    let j := t.natAbs >>> (PR - TB)
    let d : Int := (t.natAbs : Int) - (j : Int) * 2 ^ (PR - TB)
    let e := csLit j
    let cd := (sinCosTiny d).1
    let sd := (sinCosTiny d).2
    let c := Iv.sub (Iv.mul e.1 cd) (Iv.mul e.2 sd)
    let s := Iv.add (Iv.mul e.2 cd) (Iv.mul e.1 sd)
    (clip1 c, clip1 (if t < 0 then Iv.neg s else s))
  else csTrivial

/-- componentwise equality test of two pairs of intervals -/
def ivPairEqB (e f : Iv × Iv) : Bool :=
  e.1.lo == f.1.lo && e.1.hi == f.1.hi && e.2.lo == f.2.lo && e.2.hi == f.2.hi

theorem ivPairEqB_eq {e f : Iv × Iv} (h : ivPairEqB e f = true) : e = f := by
  obtain ⟨⟨a, b⟩, ⟨c, d⟩⟩ := e
  obtain ⟨⟨a', b'⟩, ⟨c', d'⟩⟩ := f
  simp only [ivPairEqB, Bool.and_eq_true, beq_iff_eq] at h
  obtain ⟨⟨⟨h1, h2⟩, h3⟩, h4⟩ := h
  subst h1 h2 h3 h4
  rfl

end BHH.Cert
